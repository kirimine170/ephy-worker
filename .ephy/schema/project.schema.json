{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kirimine170/ephy-repository-template/blob/main/.ephy/schema/project.schema.json",
  "title": "Ephy project metadata",
  "description": "Metadata declared by an Ephy ecosystem repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "relations",
    "data_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "type",
        "status",
        "visibility",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/projectId"
        },
        "family": {
          "const": "ephy"
        },
        "type": {
          "enum": [
            "meta",
            "core",
            "model",
            "extension",
            "integration",
            "application",
            "private-instance",
            "template"
          ]
        },
        "status": {
          "enum": [
            "concept",
            "design",
            "active",
            "maintenance",
            "hold",
            "deprecated"
          ]
        },
        "visibility": {
          "enum": [
            "private",
            "internal",
            "public"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "depends_on",
        "integrates_with",
        "runs_on"
      ],
      "properties": {
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/projectId"
            },
            {
              "type": "null"
            }
          ]
        },
        "depends_on": {
          "$ref": "#/$defs/projectIdList"
        },
        "integrates_with": {
          "$ref": "#/$defs/projectIdList"
        },
        "runs_on": {
          "$ref": "#/$defs/projectIdList"
        }
      }
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "personal_data_in_git",
        "secrets_in_git"
      ],
      "properties": {
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "personal_data_in_git": {
          "const": "prohibited"
        },
        "secrets_in_git": {
          "const": "prohibited"
        }
      }
    }
  },
  "$defs": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "projectIdList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/projectId"
      }
    }
  }
}
