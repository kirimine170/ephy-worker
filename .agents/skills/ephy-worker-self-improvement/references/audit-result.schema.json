{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ephy.local/schemas/audit-result-v1.json",
  "title": "ephy-worker independent audit result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "job_id",
    "decision",
    "reason_codes",
    "bound_inputs",
    "documents_read",
    "integrity",
    "candidate",
    "workflow",
    "findings",
    "missing_or_invalid_evidence",
    "human_report",
    "auditor_assertions"
  ],
  "properties": {
    "schema_version": {
      "const": "ephy.audit-result.v1"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "decision": {
      "enum": [
        "ACCEPT_PROPOSAL",
        "REJECT_PROPOSAL",
        "INCONCLUSIVE"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ALL_GATES_PASSED",
          "EVIDENCE_INTEGRITY_FAILED",
          "INSUFFICIENT_EVIDENCE",
          "CANDIDATE_FAILED",
          "WORKFLOW_FAILED",
          "MODEL_MISMATCH",
          "STALE_VERIFICATION",
          "SCOPE_VIOLATION",
          "AUDIT_CONTRACT_VIOLATION"
        ]
      }
    },
    "bound_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_input_sha256",
        "evidence_manifest_sha256",
        "prompt_template_sha256",
        "candidate_patch_sha256",
        "candidate_snapshot_manifest_sha256",
        "verification_results_sha256",
        "workflow_events_sha256",
        "model_provenance_sha256"
      ],
      "properties": {
        "audit_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_patch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_snapshot_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_results_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_events_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_provenance_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "documents_read": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "prefixItems": [
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "system_development_policy"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "task_spec"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "required_skill"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "evaluation_contract"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "environment_contract"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "audit_contract"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "audit_prompt"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "audit_input_schema"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "evidence_manifest_schema"
            }
          }
        },
        {
          "$ref": "#/$defs/documentRead",
          "properties": {
            "artifact_id": {
              "const": "audit_result_schema"
            }
          }
        }
      ],
      "items": false
    },
    "integrity": {
      "$ref": "#/$defs/domainResult"
    },
    "candidate": {
      "$ref": "#/$defs/domainResult"
    },
    "workflow": {
      "$ref": "#/$defs/domainResult"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "missing_or_invalid_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "reason"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "human_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "summary",
        "candidate_summary",
        "workflow_summary",
        "blockers",
        "next_action"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "candidate_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "workflow_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "auditor_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repair_attempted",
        "write_attempted",
        "tests_rerun",
        "network_used",
        "subagent_used",
        "repository_or_release_action_attempted"
      ],
      "properties": {
        "repair_attempted": {
          "const": false
        },
        "write_attempted": {
          "const": false
        },
        "tests_rerun": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "subagent_used": {
          "const": false
        },
        "repository_or_release_action_attempted": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ACCEPT_PROPOSAL"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "const": [
              "ALL_GATES_PASSED"
            ]
          },
          "integrity": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "candidate": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "workflow": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          },
          "missing_or_invalid_evidence": {
            "maxItems": 0
          },
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {
                    "enum": [
                      "blocker",
                      "major"
                    ]
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          },
          "human_report": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "reason_codes": {
            "not": {
              "contains": {
                "const": "ALL_GATES_PASSED"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256",
        "location"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "summary",
        "evidence"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[ICW][0-9]{2}_[A-Z0-9_]+$"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "domainResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "not": {
                  "contains": {
                    "properties": {
                      "status": {
                        "enum": [
                          "FAIL",
                          "INCONCLUSIVE"
                        ]
                      }
                    },
                    "required": [
                      "status"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAIL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "FAIL"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INCONCLUSIVE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "INCONCLUSIVE"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "documentRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "domain",
        "severity",
        "summary",
        "rule_id",
        "evidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "domain": {
          "enum": [
            "integrity",
            "candidate",
            "workflow"
          ]
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "info"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    }
  }
}
