{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ephy.local/schemas/audit-input-v1.json",
  "title": "ephy-worker independent audit input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "job_id",
    "created_at",
    "proposal_only",
    "baseline_commit",
    "evidence_manifest_path",
    "evidence_manifest_sha256",
    "bundle_integrity_attestation_path",
    "bundle_integrity_attestation_sha256",
    "control_document_hashes",
    "final_bindings",
    "allowed_file_scope",
    "semantic_scope",
    "forbidden_actions",
    "required_checks",
    "stage_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "ephy.audit-input.v1"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposal_only": {
      "const": true
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "evidence_manifest_path": {
      "$ref": "#/$defs/bundleRelativePath"
    },
    "evidence_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "bundle_integrity_attestation_path": {
      "$ref": "#/$defs/bundleRelativePath"
    },
    "bundle_integrity_attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "control_document_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_development_policy",
        "required_skill",
        "evaluation_contract",
        "environment_contract",
        "audit_contract",
        "audit_prompt",
        "audit_input_schema",
        "evidence_manifest_schema",
        "audit_result_schema"
      ],
      "properties": {
        "system_development_policy": {
          "$ref": "#/$defs/sha256"
        },
        "required_skill": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_contract": {
          "$ref": "#/$defs/sha256"
        },
        "environment_contract": {
          "$ref": "#/$defs/sha256"
        },
        "audit_contract": {
          "$ref": "#/$defs/sha256"
        },
        "audit_prompt": {
          "$ref": "#/$defs/sha256"
        },
        "audit_input_schema": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_manifest_schema": {
          "$ref": "#/$defs/sha256"
        },
        "audit_result_schema": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "final_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_patch_sha256",
        "candidate_snapshot_manifest_sha256",
        "changed_files_manifest_sha256",
        "verification_results_sha256",
        "workflow_events_sha256",
        "model_provenance_sha256"
      ],
      "properties": {
        "candidate_patch_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_snapshot_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "changed_files_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verification_results_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_events_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_provenance_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "allowed_file_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bundleRelativePath"
      }
    },
    "semantic_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "stage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_sequence",
        "max_repair_attempts",
        "expected_models",
        "verifier_identity"
      ],
      "properties": {
        "required_sequence": {
          "type": "array",
          "prefixItems": [
            {
              "const": "preflight"
            },
            {
              "const": "gpt-oss lead plan"
            },
            {
              "const": "qwen attempt loop"
            },
            {
              "const": "freeze final candidate and audit bundle"
            },
            {
              "const": "fresh gpt-oss audit"
            },
            {
              "const": "proposal stop"
            }
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "max_repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "expected_models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "planner",
            "implementer",
            "auditor"
          ],
          "properties": {
            "planner": {
              "$ref": "#/$defs/modelIdentity"
            },
            "implementer": {
              "$ref": "#/$defs/modelIdentity"
            },
            "auditor": {
              "$ref": "#/$defs/modelIdentity"
            }
          }
        },
        "verifier_identity": {
          "$ref": "#/$defs/executorIdentity"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundleRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "modelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_artifact_manifest_sha256",
        "runtime_sha256",
        "invocation_config_sha256"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "model_artifact_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "invocation_config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "executorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor_id",
        "runtime_sha256",
        "invocation_config_sha256"
      ],
      "properties": {
        "executor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "runtime_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "invocation_config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
